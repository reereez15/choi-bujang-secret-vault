{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/notes.js": {
      "includeFiles": "aleph.config.json"
    },
    "api/my/notes.js": {
      "includeFiles": "aleph.config.json"
    },
    "api/notes/[id].js": {
      "includeFiles": "aleph.config.json"
    },
    "api/restore/note.js": {
      "includeFiles": "{aleph.config.json,memo-backup.json}"
    },
    "api/device/check.js": {
      "includeFiles": "aleph.config.json"
    },
    "api/auth/logout.js": {
      "includeFiles": "aleph.config.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
